{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-croatian",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  // The built PWA is served as static assets; only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Wrangler looks the database up by name, so no database_id is needed.
      "database_name": "learn-croatian-db",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (not stored here): SYNC_TOKEN — add it in the dashboard under
  // Worker → Settings → Variables and Secrets (type: Secret).
}
